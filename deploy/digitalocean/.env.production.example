# DUTS — DigitalOcean production environment
# Copy to /opt/gigflow/.env.production on the server. NEVER commit real secrets.

# --- Domains & TLS ---
API_DOMAIN=api.duts.tech
ADMIN_DOMAIN=admin.duts.tech
APP_DOMAIN=app.duts.tech
MARKETING_DOMAIN=www.duts.tech
# Apex / root domain — 301 redirects to MARKETING_DOMAIN (canonical www)
ROOT_DOMAIN=duts.tech
LETSENCRYPT_EMAIL=info@duts.tech
VITE_API_URL=https://api.duts.tech/v1

# Marketing site (Astro) build args — PUBLIC_SITE_URL must be the canonical www URL
PUBLIC_SITE_URL=https://www.duts.tech
PUBLIC_APP_URL=https://app.duts.tech
PUBLIC_SUPPORT_EMAIL=info@duts.tech
PUBLIC_SUPPORT_PHONE=+12036769717

# Expo web build args (baked into Nginx image at deploy time)
EXPO_PUBLIC_API_URL=https://api.duts.tech/v1
EXPO_PUBLIC_SUPPORT_EMAIL=info@duts.tech
EXPO_PUBLIC_SUPPORT_PHONE=+12036769717
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Application ---
NODE_ENV=production
PORT=4000
API_PUBLIC_URL=https://api.duts.tech
MOBILE_PUBLIC_URL=https://app.duts.tech
CORS_ORIGINS=https://admin.duts.tech,https://app.duts.tech,https://www.duts.tech,https://duts.tech,http://localhost:8081,http://localhost:4321
TRUST_PROXY=true
RUN_SEED=false
LOG_VERIFICATION_TO_CONSOLE=false

# --- PostgreSQL (Docker service) ---
POSTGRES_DB=gigflow
POSTGRES_USER=gigflow
POSTGRES_PASSWORD=change-me-strong-random-password

# --- Auth ---
JWT_SECRET=change-me-minimum-32-characters-random-secret
ADMIN_SEED_PASSWORD=change-me-minimum-12-characters

# --- Firebase (social login + FCM when enabled) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Stripe Connect (production live keys when ready) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Use real sk_test_/pk_test_ (or live) values from the Stripe Dashboard.
# Placeholder values such as REPLACE_… are rejected and will prevent API startup in production.

# --- DigitalOcean Spaces (S3-compatible uploads) ---
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=gigflow-uploads
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_CDN_URL=https://gigflow-uploads.nyc3.cdn.digitaloceanspaces.com

# Legacy S3 env aliases (optional — Spaces lib reads SPACES_* first)
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email ---
# Recommended (free): Resend — https://resend.com
# 1) Create account → API Keys → create key
# 2) Add/verify domain (or use onboarding@resend.dev for testing only)
# 3) Set:
EMAIL_FROM=info@duts.tech
RESEND_API_KEY=
# Optional legacy: SENDGRID_API_KEY=
# Beta without a provider: set LOG_VERIFICATION_TO_CONSOLE=true and copy links from API logs


# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Logging ---
LOG_LEVEL=info
# SENTRY_DSN=   # omit entirely unless using Sentry

# --- Deploy paths (optional overrides) ---
GIGFLOW_ROOT=/opt/gigflow
GIGFLOW_ENV_FILE=/opt/gigflow/.env.production
BACKUP_RETENTION_DAYS=14

# NEVER enable in production:
# ALLOW_DEV_PAYMENT_BYPASS=true
# ALLOW_DEV_SESSION=true
