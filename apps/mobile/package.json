{
  "name": "@gigflow/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eas:login": "npx eas-cli login",
    "eas:build:android": "npx eas-cli build --platform android --profile production",
    "eas:build:ios": "npx eas-cli build --platform ios --profile production",
    "eas:submit:android": "npx eas-cli submit --platform android --profile production",
    "eas:submit:ios": "npx eas-cli submit --platform ios --profile production"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@gigflow/shared": "file:../../packages/shared",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.14",
    "@tanstack/react-query": "^5.100.11",
    "dotenv": "^16.6.1",
    "expo": "^56.0.5",
    "expo-apple-authentication": "~56.0.4",
    "expo-constants": "^56.0.14",
    "expo-crypto": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-image-manipulator": "~56.0.21",
    "expo-image-picker": "~56.0.20",
    "expo-linear-gradient": "~56.0.4",
    "expo-location": "~56.0.3",
    "firebase": "^12.16.0",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "~0.10.2",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets",
        "react-native-gesture-handler"
      ]
    }
  }
}
