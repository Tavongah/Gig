generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  WORKER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum GigStatus {
  POSTED
  WORKER_SELECTED
  SEARCHING_FOR_WORKER
  WORKER_ASSIGNED
  WORKER_EN_ROUTE
  WORKER_ARRIVED
  IN_PROGRESS
  WAITING_EXTRA_TIME_APPROVAL
  WAITING_CUSTOMER_CONFIRMATION
  COMPLETED
  CANCELLED
  DRAFT
  DISPUTED
}

enum PricingType {
  FIXED
  HOURLY
  ESTIMATE_TIMER
}

enum GigInterestStatus {
  INTERESTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum GigUrgency {
  STANDARD
  SOON
  URGENT
}

enum GigSize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum PaymentLifecycle {
  PAYMENT_PENDING
  PAYMENT_AUTHORIZED
  PAYMENT_CAPTURED
  PAYOUT_PENDING
  PAYOUT_PAID
  PAYMENT_FAILED
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  AUTHORIZED
  CAPTURED
  PAYOUT_PENDING
  PAID_OUT
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum TransactionType {
  CLIENT_CHARGE
  PLATFORM_COMMISSION
  WORKER_PAYOUT
  REFUND
  ADJUSTMENT
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum WorkerEarningsTransactionType {
  GIG_COMPLETED_CREDIT
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_SUCCESS
  WITHDRAWAL_FAILED
}

enum WorkerEarningsTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LaunchPhase {
  MVP
  PHASE_2
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

model User {
  id                   String              @id @default(uuid())
  firebaseUid          String?             @unique
  authProvider         AuthProvider        @default(EMAIL)
  email                String              @unique
  phoneNumber          String?             @unique
  passwordHash         String?
  fullName             String
  avatarUrl            String?
  roles                UserRole[]          @default([CLIENT])
  defaultRole          UserRole            @default(CLIENT)
  accountStatus        AccountStatus       @default(ACTIVE)
  emailVerified        Boolean             @default(false)
  phoneVerified        Boolean             @default(false)
  profileCompleted     Boolean             @default(false)
  isVerified           Boolean             @default(false)
  formattedAddress     String?
  addressLine1         String?
  city                 String?
  region               String?
  postalCode           String?
  country              String?             @default("US")
  latitude             Decimal?            @db.Decimal(9, 6)
  longitude            Decimal?            @db.Decimal(9, 6)
  stripeCustomerId     String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workerProfile        WorkerProfile?
  passwordResetTokens  PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  clientGigs         Gig[]               @relation("ClientGigs")
  workerAssignments  GigAssignment[]     @relation("WorkerAssignments")
  workerInterests    GigInterest[]       @relation("WorkerInterests")
  reviewsGiven       Review[]            @relation("ReviewsGiven")
  reviewsReceived    Review[]            @relation("ReviewsReceived")
  notifications      Notification[]
  devicePushTokens DevicePushToken[]
  availability       AvailabilityWindow[]
  chatMessages       ChatMessage[]
  auditLogs          AuditLog[]
  earningsTransactions WorkerEarningsTransaction[]
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model WorkerProfile {
  id                       String            @id @default(uuid())
  userId                   String            @unique
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                      String
  city                     String?
  serviceArea              String?
  workExperience           String?
  hasVehicle               Boolean           @default(false)
  backgroundCheckConsent   Boolean           @default(false)
  backgroundCheckCompleted Boolean           @default(false)
  governmentIdAcknowledged Boolean           @default(false)
  proofOfAddressAcknowledged Boolean         @default(false)
  platformRulesAgreed      Boolean           @default(false)
  reviewedAt               DateTime?
  reviewedById             String?
  rejectionReason          String?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean           @default(false)
  stripeChargesEnabled     Boolean           @default(false)
  stripePayoutsEnabled     Boolean           @default(false)
  formattedAddress         String?
  locationUpdatedAt        DateTime?
  availableBalanceCents    Int               @default(0)
  withdrawnBalanceCents    Int               @default(0)
  totalEarnedCents         Int               @default(0)
  ratingAverage            Decimal           @default(0) @db.Decimal(3, 2)
  completedGigCount        Int               @default(0)
  currentLatitude          Decimal?          @db.Decimal(9, 6)
  currentLongitude         Decimal?          @db.Decimal(9, 6)
  availabilityStatus       AvailabilityStatus @default(OFFLINE)
  travelDistanceMiles      Decimal           @default(10) @db.Decimal(5, 2)
  hourlyRateCents          Int?
  minJobAmountCents        Int               @default(5000)
  serviceCategories        ServiceCategory[] @relation("WorkerCategories")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([currentLatitude, currentLongitude])
}

model ServiceCategory {
  id                 String          @id @default(uuid())
  slug               String          @unique
  name               String
  description        String
  iconName           String
  baseRateCents      Int
  hourlyRateCents    Int
  distanceRateCents  Int             @default(175)
  multiplier         Decimal         @default(1) @db.Decimal(4, 2)
  launchPhase        LaunchPhase     @default(MVP)
  isActive           Boolean         @default(true)
  gigs               Gig[]
  workers            WorkerProfile[] @relation("WorkerCategories")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Gig {
  id                    String          @id @default(uuid())
  clientId              String
  client                User            @relation("ClientGigs", fields: [clientId], references: [id], onDelete: Restrict)
  serviceCategoryId     String
  serviceCategory       ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  title                 String
  description           String
  status                GigStatus         @default(POSTED)
  paymentStatus         PaymentLifecycle  @default(PAYMENT_PENDING)
  pricingType           PricingType       @default(HOURLY)
  paymentIntentId       String?
  checkoutSessionId     String?
  assignedWorkerId      String?
  publishedAt           DateTime?
  authorizedAt          DateTime?
  customerApprovedAt    DateTime?
  autoApproveAt         DateTime?
  taxCents              Int               @default(0)
  /** Client-generated key so duplicate Request Help submissions return the same gig. */
  idempotencyKey        String?           @unique
  finalTotalCents       Int?
  authorizationBufferCents Int            @default(0)
  maximumAuthorizedAmountCents Int?
  billingIncrementMinutes Int             @default(15)
  urgency               GigUrgency
  size                  GigSize
  estimatedHours        Decimal         @db.Decimal(5, 2)
  distanceMiles         Decimal         @db.Decimal(7, 2)
  demandMultiplier      Decimal         @default(1) @db.Decimal(4, 2)
  startsAt              DateTime
  addressLine1          String
  addressLine2          String?
  city                  String
  region                String
  postalCode            String
  country               String          @default("US")
  formattedAddress      String?
  latitude              Decimal         @db.Decimal(9, 6)
  longitude             Decimal         @db.Decimal(9, 6)
  photoUrls             String[]        @default([])
  priceBreakdown        Json
  totalCents            Int
  platformFeeCents      Int
  workerPayoutCents     Int
  assignments           GigAssignment[]
  interests             GigInterest[]
  payment               Payment?
  earningsTransactions  WorkerEarningsTransaction[]
  reviews               Review[]
  chatThread            ChatThread?
  notifications         Notification[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status, serviceCategoryId, startsAt])
  @@index([latitude, longitude])
}

model GigInterest {
  id                       String            @id @default(uuid())
  gigId                    String
  gig                      Gig               @relation(fields: [gigId], references: [id], onDelete: Cascade)
  workerId                 String
  worker                   User              @relation("WorkerInterests", fields: [workerId], references: [id], onDelete: Restrict)
  status                   GigInterestStatus @default(INTERESTED)
  offeredWorkerPayoutCents Int?
  estimatedArrivalMinutes  Int?
  estimatedHours           Decimal?          @db.Decimal(5, 2)
  message                  String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([gigId, workerId])
  @@index([gigId, status])
}

model GigAssignment {
  id                       String    @id @default(uuid())
  gigId                    String
  gig                      Gig       @relation(fields: [gigId], references: [id], onDelete: Cascade)
  workerId                 String
  worker                   User      @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: Restrict)
  acceptedAt               DateTime  @default(now())
  enRouteAt                DateTime?
  arrivedAt                DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  endedAt                  DateTime?
  cancelledAt              DateTime?
  startLatitude            Decimal?  @db.Decimal(9, 6)
  startLongitude           Decimal?  @db.Decimal(9, 6)
  endLatitude              Decimal?  @db.Decimal(9, 6)
  endLongitude             Decimal?  @db.Decimal(9, 6)
  billableMinutes          Int?
  actualWorkedSeconds      Int?
  billableSeconds          Int?
  totalApprovedPausedSeconds Int     @default(0)
  timerPausedAt            DateTime?
  extraTimeApprovedMinutes Int       @default(0)
  completionNotes          String?
  completionPhotoUrls      String[]  @default([])

  @@unique([gigId, workerId])
  @@index([workerId, acceptedAt])
}

model Payment {
  id                      String        @id @default(uuid())
  gigId                   String        @unique
  gig                     Gig           @relation(fields: [gigId], references: [id], onDelete: Cascade)
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?       @unique
  stripeChargeId          String?
  stripeTransferId        String?       @unique
  stripeRefundId          String?
  status                  PaymentStatus @default(REQUIRES_PAYMENT_METHOD)
  authorizationStatus     String?
  authorizedAt            DateTime?
  captureBefore           DateTime?
  capturedAt              DateTime?
  maximumAuthorizedAmountCents Int?
  amountCents             Int
  platformFeeCents        Int
  workerPayoutCents       Int
  refundAmountCents       Int           @default(0)
  currency                String        @default("usd")
  transactions            Transaction[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Transaction {
  id          String          @id @default(uuid())
  paymentId   String
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type        TransactionType
  amountCents Int
  metadata    Json?
  createdAt   DateTime        @default(now())
}

model WorkerEarningsTransaction {
  id               String                          @id @default(uuid())
  workerId         String
  worker           User                            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  gigId            String?
  gig              Gig?                            @relation(fields: [gigId], references: [id], onDelete: SetNull)
  type             WorkerEarningsTransactionType
  status           WorkerEarningsTransactionStatus @default(PENDING)
  amountCents      Int
  stripeTransferId String?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([workerId, createdAt])
  @@index([gigId, type])
}

model Review {
  id          String   @id @default(uuid())
  gigId       String
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([gigId, reviewerId])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gigId     String?
  gig       Gig?                @relation(fields: [gigId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String
  payload   Json?
  createdAt DateTime            @default(now())
  readAt    DateTime?
}

model AvailabilityWindow {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AvailabilityStatus @default(AVAILABLE)
  startsAt    DateTime
  endsAt      DateTime
  latitude    Decimal?           @db.Decimal(9, 6)
  longitude   Decimal?           @db.Decimal(9, 6)
  createdAt   DateTime           @default(now())

  @@index([userId, startsAt, endsAt])
}

model ChatThread {
  id        String        @id @default(uuid())
  gigId     String        @unique
  gig       Gig           @relation(fields: [gigId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime   @default(now())
  readAt    DateTime?
}

model CommissionSetting {
  id             String   @id @default(uuid())
  rate           Decimal  @default(0.20) @db.Decimal(4, 3)
  effectiveFrom  DateTime @default(now())
  createdById    String?
  createdAt      DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}
