generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  WORKER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum GigStatus {
  POSTED
  WORKER_SELECTED
  SEARCHING_FOR_WORKER
  WORKER_ASSIGNED
  WORKER_EN_ROUTE
  WORKER_ARRIVED
  PACKAGE_COLLECTED
  EN_ROUTE_TO_DROPOFF
  ARRIVED_AT_DROPOFF
  IN_PROGRESS
  WAITING_EXTRA_TIME_APPROVAL
  WAITING_CUSTOMER_CONFIRMATION
  COMPLETED
  CANCELLED
  DRAFT
  DISPUTED
}

enum FulfillmentType {
  LOCAL_HELP
  DELIVERY
}

enum OrderSource {
  APP
  WEB
  WHATSAPP
}

enum TransportMode {
  WALKING
  BICYCLE
  PUBLIC_TRANSPORT
  MOTORBIKE
  CAR
}

enum PackageCategory {
  DOCUMENTS
  FOOD
  GROCERIES
  CLOTHING
  SMALL_PARCEL
  OTHER
}

enum PricingType {
  FIXED
  HOURLY
  ESTIMATE_TIMER
}

enum GigInterestStatus {
  INTERESTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum GigUrgency {
  STANDARD
  SOON
  URGENT
}

enum GigSize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum PaymentLifecycle {
  PAYMENT_PENDING
  PAYMENT_AUTHORIZED
  PAYMENT_CAPTURED
  PAYOUT_PENDING
  PAYOUT_PAID
  PAYMENT_FAILED
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  AUTHORIZED
  CAPTURED
  PAYOUT_PENDING
  PAID_OUT
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum TransactionType {
  CLIENT_CHARGE
  PLATFORM_COMMISSION
  WORKER_PAYOUT
  REFUND
  ADJUSTMENT
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum WorkerEarningsTransactionType {
  GIG_COMPLETED_CREDIT
  CANCELLATION_FEE_CREDIT
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_SUCCESS
  WITHDRAWAL_FAILED
}

enum WorkerEarningsTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LaunchPhase {
  MVP
  PHASE_2
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

model User {
  id                   String              @id @default(uuid())
  firebaseUid          String?             @unique
  authProvider         AuthProvider        @default(EMAIL)
  email                String              @unique
  phoneNumber          String?             @unique
  passwordHash         String?
  fullName             String
  avatarUrl            String?
  roles                UserRole[]          @default([CLIENT])
  defaultRole          UserRole            @default(CLIENT)
  accountStatus        AccountStatus       @default(ACTIVE)
  emailVerified        Boolean             @default(false)
  phoneVerified        Boolean             @default(false)
  profileCompleted     Boolean             @default(false)
  isVerified           Boolean             @default(false)
  formattedAddress     String?
  addressLine1         String?
  city                 String?
  region               String?
  postalCode           String?
  country              String?             @default("US")
  latitude             Decimal?            @db.Decimal(9, 6)
  longitude            Decimal?            @db.Decimal(9, 6)
  stripeCustomerId     String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workerProfile        WorkerProfile?
  passwordResetTokens  PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  clientGigs         Gig[]               @relation("ClientGigs")
  workerAssignments  GigAssignment[]     @relation("WorkerAssignments")
  workerInterests    GigInterest[]       @relation("WorkerInterests")
  reviewsGiven       Review[]            @relation("ReviewsGiven")
  reviewsReceived    Review[]            @relation("ReviewsReceived")
  notifications      Notification[]
  devicePushTokens DevicePushToken[]
  availability       AvailabilityWindow[]
  chatMessages       ChatMessage[]
  auditLogs          AuditLog[]
  earningsTransactions WorkerEarningsTransaction[]
  ownedMerchants       Merchant[]                  @relation("MerchantOwner")
  commerceOrders       CommerceOrder[]             @relation("CommerceOrderUser")
  commerceCustomers    CommerceCustomer[]          @relation("CommerceCustomerUser")
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model WorkerProfile {
  id                       String            @id @default(uuid())
  userId                   String            @unique
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                      String
  city                     String?
  serviceArea              String?
  workExperience           String?
  hasVehicle               Boolean           @default(false)
  /** Courier transport for DUTS Delivery. LOCAL_HELP workers may leave null. */
  transportMode            TransportMode?
  /** Courier opted into DUTS Delivery matching. Requires Phase-1 transportMode. */
  deliveryEligible         Boolean           @default(false)
  backgroundCheckConsent   Boolean           @default(false)
  backgroundCheckCompleted Boolean           @default(false)
  governmentIdAcknowledged Boolean           @default(false)
  proofOfAddressAcknowledged Boolean         @default(false)
  platformRulesAgreed      Boolean           @default(false)
  /** Private Spaces object keys for identity documents (never public URLs). */
  governmentIdType         String?
  governmentIdFrontKey     String?
  governmentIdBackKey      String?
  identityVerificationStatus String          @default("PENDING")
  identityDocumentsUploadedAt DateTime?
  reviewedAt               DateTime?
  reviewedById             String?
  rejectionReason          String?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean           @default(false)
  stripeChargesEnabled     Boolean           @default(false)
  stripePayoutsEnabled     Boolean           @default(false)
  formattedAddress         String?
  locationUpdatedAt        DateTime?
  availableBalanceCents    Int               @default(0)
  withdrawnBalanceCents    Int               @default(0)
  totalEarnedCents         Int               @default(0)
  ratingAverage            Decimal           @default(0) @db.Decimal(3, 2)
  completedGigCount        Int               @default(0)
  currentLatitude          Decimal?          @db.Decimal(9, 6)
  currentLongitude         Decimal?          @db.Decimal(9, 6)
  availabilityStatus       AvailabilityStatus @default(OFFLINE)
  travelDistanceMiles      Decimal           @default(10) @db.Decimal(5, 2)
  hourlyRateCents          Int?
  minJobAmountCents        Int               @default(5000)
  serviceCategories        ServiceCategory[] @relation("WorkerCategories")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([currentLatitude, currentLongitude])
}

model ServiceCategory {
  id                 String          @id @default(uuid())
  slug               String          @unique
  name               String
  description        String
  iconName           String
  baseRateCents      Int
  hourlyRateCents    Int
  distanceRateCents  Int             @default(175)
  multiplier         Decimal         @default(1) @db.Decimal(4, 2)
  launchPhase        LaunchPhase     @default(MVP)
  isActive           Boolean         @default(true)
  gigs               Gig[]
  workers            WorkerProfile[] @relation("WorkerCategories")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Gig {
  id                    String          @id @default(uuid())
  clientId              String
  client                User            @relation("ClientGigs", fields: [clientId], references: [id], onDelete: Restrict)
  serviceCategoryId     String
  serviceCategory       ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  title                 String
  description           String
  status                GigStatus         @default(POSTED)
  fulfillmentType       FulfillmentType   @default(LOCAL_HELP)
  orderSource           OrderSource       @default(APP)
  paymentStatus         PaymentLifecycle  @default(PAYMENT_PENDING)
  pricingType           PricingType       @default(HOURLY)
  paymentIntentId       String?
  checkoutSessionId     String?
  assignedWorkerId      String?
  publishedAt           DateTime?
  authorizedAt          DateTime?
  customerApprovedAt    DateTime?
  autoApproveAt         DateTime?
  taxCents              Int               @default(0)
  /** Client-generated key so duplicate Request Help submissions return the same gig. */
  idempotencyKey        String?           @unique
  travelStartedAt       DateTime?
  cancellationGraceEndsAt DateTime?
  cancelledAt           DateTime?
  cancellationFeeCents  Int               @default(0)
  cancellationFeePaid   Boolean           @default(false)
  cancellationReason    String?
  cancelledBy           String?
  travelDurationSeconds Int?
  finalTotalCents       Int?
  authorizationBufferCents Int            @default(0)
  maximumAuthorizedAmountCents Int?
  billingIncrementMinutes Int             @default(15)
  urgency               GigUrgency
  size                  GigSize
  estimatedHours        Decimal         @db.Decimal(5, 2)
  distanceMiles         Decimal         @db.Decimal(7, 2)
  demandMultiplier      Decimal         @default(1) @db.Decimal(4, 2)
  startsAt              DateTime
  addressLine1          String
  addressLine2          String?
  city                  String
  region                String
  postalCode            String
  country               String          @default("US")
  formattedAddress      String?
  latitude              Decimal         @db.Decimal(9, 6)
  longitude             Decimal         @db.Decimal(9, 6)
  /** DUTS Delivery: pickup (mirrors legacy location for matching when fulfillmentType=DELIVERY). */
  pickupContactName     String?
  pickupContactPhone    String?
  pickupInstructions    String?
  dropoffAddressLine1   String?
  dropoffAddressLine2   String?
  dropoffCity           String?
  dropoffRegion         String?
  dropoffPostalCode     String?
  dropoffCountry        String?
  dropoffFormattedAddress String?
  dropoffLatitude       Decimal?        @db.Decimal(9, 6)
  dropoffLongitude      Decimal?        @db.Decimal(9, 6)
  dropoffContactName    String?
  dropoffContactPhone   String?
  dropoffInstructions   String?
  packageCategory       PackageCategory?
  packageDescription    String?
  packageSize           String?
  packagePhotoUrl       String?
  packageNotes          String?
  estimatedDistanceKm   Decimal?        @db.Decimal(8, 3)
  /** Hashed verification codes — never return raw values from generic serializers. */
  pickupPin             String?
  deliveryPin           String?
  pickupPinFailCount    Int             @default(0)
  deliveryPinFailCount  Int             @default(0)
  pickupPinLockedUntil  DateTime?
  deliveryPinLockedUntil DateTime?
  pickupVerifiedAt      DateTime?
  deliveryVerifiedAt    DateTime?
  prohibitedItemsAck    Boolean         @default(false)
  photoUrls             String[]        @default([])
  priceBreakdown        Json
  totalCents            Int
  platformFeeCents      Int
  workerPayoutCents     Int
  assignments           GigAssignment[]
  interests             GigInterest[]
  payment               Payment?
  earningsTransactions  WorkerEarningsTransaction[]
  reviews               Review[]
  chatThread            ChatThread?
  notifications         Notification[]
  commerceOrder         CommerceOrder?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status, serviceCategoryId, startsAt])
  @@index([latitude, longitude])
}

model GigInterest {
  id                       String            @id @default(uuid())
  gigId                    String
  gig                      Gig               @relation(fields: [gigId], references: [id], onDelete: Cascade)
  workerId                 String
  worker                   User              @relation("WorkerInterests", fields: [workerId], references: [id], onDelete: Restrict)
  status                   GigInterestStatus @default(INTERESTED)
  offeredWorkerPayoutCents Int?
  estimatedArrivalMinutes  Int?
  estimatedHours           Decimal?          @db.Decimal(5, 2)
  message                  String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([gigId, workerId])
  @@index([gigId, status])
}

model GigAssignment {
  id                       String    @id @default(uuid())
  gigId                    String
  gig                      Gig       @relation(fields: [gigId], references: [id], onDelete: Cascade)
  workerId                 String
  worker                   User      @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: Restrict)
  acceptedAt               DateTime  @default(now())
  enRouteAt                DateTime?
  arrivedAt                DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  endedAt                  DateTime?
  cancelledAt              DateTime?
  startLatitude            Decimal?  @db.Decimal(9, 6)
  startLongitude           Decimal?  @db.Decimal(9, 6)
  endLatitude              Decimal?  @db.Decimal(9, 6)
  endLongitude             Decimal?  @db.Decimal(9, 6)
  billableMinutes          Int?
  actualWorkedSeconds      Int?
  billableSeconds          Int?
  totalApprovedPausedSeconds Int     @default(0)
  timerPausedAt            DateTime?
  extraTimeApprovedMinutes Int       @default(0)
  completionNotes          String?
  completionPhotoUrls      String[]  @default([])

  @@unique([gigId, workerId])
  @@index([workerId, acceptedAt])
}

model Payment {
  id                      String        @id @default(uuid())
  gigId                   String        @unique
  gig                     Gig           @relation(fields: [gigId], references: [id], onDelete: Cascade)
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?       @unique
  stripeChargeId          String?
  stripeTransferId        String?       @unique
  stripeRefundId          String?
  status                  PaymentStatus @default(REQUIRES_PAYMENT_METHOD)
  authorizationStatus     String?
  authorizedAt            DateTime?
  captureBefore           DateTime?
  capturedAt              DateTime?
  maximumAuthorizedAmountCents Int?
  amountCents             Int
  platformFeeCents        Int
  workerPayoutCents       Int
  refundAmountCents       Int           @default(0)
  currency                String        @default("usd")
  transactions            Transaction[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Transaction {
  id          String          @id @default(uuid())
  paymentId   String
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type        TransactionType
  amountCents Int
  metadata    Json?
  createdAt   DateTime        @default(now())
}

model WorkerEarningsTransaction {
  id               String                          @id @default(uuid())
  workerId         String
  worker           User                            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  gigId            String?
  gig              Gig?                            @relation(fields: [gigId], references: [id], onDelete: SetNull)
  type             WorkerEarningsTransactionType
  status           WorkerEarningsTransactionStatus @default(PENDING)
  amountCents      Int
  stripeTransferId String?
  failureReason    String?
  metadata         Json?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([workerId, createdAt])
  @@index([gigId, type])
}

model Review {
  id          String   @id @default(uuid())
  gigId       String
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([gigId, reviewerId])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gigId     String?
  gig       Gig?                @relation(fields: [gigId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String
  payload   Json?
  createdAt DateTime            @default(now())
  readAt    DateTime?
}

model AvailabilityWindow {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AvailabilityStatus @default(AVAILABLE)
  startsAt    DateTime
  endsAt      DateTime
  latitude    Decimal?           @db.Decimal(9, 6)
  longitude   Decimal?           @db.Decimal(9, 6)
  createdAt   DateTime           @default(now())

  @@index([userId, startsAt, endsAt])
}

model ChatThread {
  id        String        @id @default(uuid())
  gigId     String        @unique
  gig       Gig           @relation(fields: [gigId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime   @default(now())
  readAt    DateTime?
}

model CommissionSetting {
  id             String   @id @default(uuid())
  rate           Decimal  @default(0.20) @db.Decimal(4, 3)
  effectiveFrom  DateTime @default(now())
  createdById    String?
  createdAt      DateTime @default(now())
}

/** Singleton-style platform policy knobs (cancellation fee %, grace minutes, etc.). */
model PlatformSetting {
  id                         String   @id @default("default")
  cancellationFeePercent     Decimal  @default(0.25) @db.Decimal(4, 3)
  cancellationGraceMinutes   Int      @default(5)
  /** DUTS Delivery Phase 1 — Harare defaults (USD cents). Temporary until market pricing is finalized. */
  deliveryMaxDistanceKm      Decimal  @default(10) @db.Decimal(6, 2)
  deliveryBaseFeeCents       Int      @default(200)
  deliveryPricePerKmCents    Int      @default(50)
  deliveryMinimumFeeCents    Int      @default(200)
  /** Stage 4 marketplace: max distance from customer to merchant (km). */
  marketplaceMerchantRadiusKm Decimal @default(5) @db.Decimal(6, 2)
  /** Optional flat service fee on commerce orders (USD cents). */
  marketplaceServiceFeeCents Int      @default(0)
  /** Merchant commission rate on item subtotal (0–1). Configurable; not final economics. */
  marketplaceMerchantCommissionRate Decimal @default(0.10) @db.Decimal(4, 3)
  updatedAt                  DateTime @updatedAt
  createdAt                  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}

// ─── Stage 4: WhatsApp shopping marketplace ─────────────────────────────────

enum MerchantCategory {
  TUCK_SHOP
  GROCERY
  BAKERY
  FOOD
  HOUSEHOLD
  OTHER
}

enum CommerceOrderStatus {
  DRAFT
  CUSTOMER_CONFIRMED
  MERCHANT_PENDING
  MERCHANT_ACCEPTED
  READY_FOR_PICKUP
  COURIER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  MERCHANT_REJECTED
  CANCELLED
  PAYMENT_FAILED
}

enum CommercePaymentStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PAYMENT_FAILED
  DUE_ON_DELIVERY
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  NOT_REQUIRED
}

enum CommercePaymentMethod {
  TEST_BYPASS
  CASH
  STRIPE
  ECOCASH
  ONEMONEY
}

enum WhatsAppParty {
  CUSTOMER
  MERCHANT
}

enum WhatsAppConversationState {
  IDLE
  AWAITING_LOCATION
  BUILDING_CART
  AWAITING_PRODUCT_CHOICE
  AWAITING_ORDER_CONFIRMATION
  AWAITING_PAYMENT
  ORDER_ACTIVE
  MERCHANT_ONBOARDING
  MERCHANT_MENU
}

model Merchant {
  id              String           @id @default(uuid())
  name            String
  ownerUserId     String?
  owner           User?            @relation("MerchantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  contactName     String
  phone           String
  whatsappPhone   String           @unique
  locationLabel   String
  latitude        Decimal          @db.Decimal(9, 6)
  longitude       Decimal          @db.Decimal(9, 6)
  category        MerchantCategory @default(TUCK_SHOP)
  logoUrl         String?
  isActive        Boolean          @default(true)
  acceptsOrders   Boolean          @default(true)
  openingHours    String?
  /** Pilot area label, e.g. Glen Norah / MSU Senga — not a polygon. */
  pilotArea       String?
  notes           String?
  products                 Product[]
  catalogProductSubmissions CatalogProduct[] @relation("CatalogProductSubmissions")
  orders                   CommerceOrder[]
  guestHandoffs            GuestCommerceHandoff[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([isActive, acceptsOrders])
  @@index([latitude, longitude])
  @@index([pilotArea])
}

/**
 * Canonical DUTS product information (shared across merchants/channels).
 * Merchant-specific price/stock lives on Product (merchant offer façade).
 */
model CatalogProduct {
  id               String                 @id @default(uuid())
  name             String
  normalizedName   String
  brand            String?
  description      String?
  category         String
  subcategory      String?
  sizeLabel        String?
  unit             String?
  barcode          String?
  primaryImageUrl  String?
  status           CatalogProductStatus   @default(APPROVED)
  source           CatalogProductSource   @default(DUTS_ADMIN)
  submittedByMerchantId String?
  submittedByMerchant   Merchant?         @relation("CatalogProductSubmissions", fields: [submittedByMerchantId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  approvedByUserId String?
  images           CatalogProductImage[]
  merchantOffers   Product[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([normalizedName])
  @@index([status])
  @@index([category])
  @@unique([barcode])
}

model CatalogProductImage {
  id               String         @id @default(uuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  url              String
  sortOrder        Int            @default(0)
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([catalogProductId, sortOrder])
}

enum CatalogProductStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum CatalogProductSource {
  DUTS_ADMIN
  MERCHANT_SUBMISSION
  IMPORT
}

/** Merchant offer / sellable inventory row. Keeps stable IDs for WhatsApp carts & orders. */
model Product {
  id               String          @id @default(uuid())
  merchantId       String
  merchant         Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  catalogProductId String?
  catalogProduct   CatalogProduct? @relation(fields: [catalogProductId], references: [id], onDelete: SetNull)
  name             String
  normalizedName   String
  description      String?
  category         String?
  priceCents       Int
  currency         String          @default("usd")
  available        Boolean         @default(true)
  quantityApprox   Int?
  unit             String?
  imageUrl         String?
  searchAliases    String[]        @default([])
  archived         Boolean         @default(false)
  orderItems       CommerceOrderItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([merchantId, archived, available])
  @@index([normalizedName])
  @@index([catalogProductId])
  @@unique([merchantId, catalogProductId])
}

enum CommerceCustomerSource {
  WHATSAPP
  WEB_GUEST
  APP
}

/**
 * Internal commerce identity — WhatsApp / guest web / app users.
 * WhatsApp shoppers do not require a User account.
 */
model CommerceCustomer {
  id             String                  @id @default(uuid())
  userId         String?
  user           User?                   @relation("CommerceCustomerUser", fields: [userId], references: [id], onDelete: SetNull)
  primaryPhone   String?
  whatsappPhone  String?
  displayName    String?
  source         CommerceCustomerSource
  orders         CommerceOrder[]
  conversations  WhatsAppConversation[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([whatsappPhone])
  @@index([primaryPhone])
  @@index([userId])
  @@index([source])
}

model CommerceOrder {
  id                   String                @id @default(uuid())
  orderNumber          Int                   @unique @default(autoincrement())
  /** Optional linked authenticated User (app). Nullable for WhatsApp / guest. */
  customerId           String?
  customer             User?                 @relation("CommerceOrderUser", fields: [customerId], references: [id], onDelete: Restrict)
  /** Primary commerce identity (WhatsApp / guest / app). */
  commerceCustomerId   String?
  commerceCustomer     CommerceCustomer?     @relation(fields: [commerceCustomerId], references: [id], onDelete: Restrict)
  merchantId           String
  merchant             Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  status               CommerceOrderStatus   @default(DRAFT)
  paymentStatus        CommercePaymentStatus @default(PENDING)
  paymentMethod        CommercePaymentMethod @default(CASH)
  orderSource          OrderSource           @default(WHATSAPP)
  subtotalCents        Int
  deliveryFeeCents     Int
  serviceFeeCents      Int                   @default(0)
  totalCents           Int
  currency             String                @default("usd")
  deliveryLabel        String
  deliveryLatitude     Decimal               @db.Decimal(9, 6)
  deliveryLongitude    Decimal               @db.Decimal(9, 6)
  linkedDeliveryGigId  String?               @unique
  linkedDeliveryGig    Gig?                  @relation(fields: [linkedDeliveryGigId], references: [id], onDelete: SetNull)
  customerWhatsAppPhone String?
  notes                String?
  /** Merchant must accept/reject before this time (Stage 4.5 timeout). */
  merchantRespondBy    DateTime?
  items                CommerceOrderItem[]
  paymentAttempts      CommercePaymentAttempt[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  confirmedAt          DateTime?
  merchantAcceptedAt   DateTime?
  readyAt              DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?

  @@index([merchantId, status])
  @@index([customerId, status])
  @@index([commerceCustomerId, status])
  @@index([status])
}

enum CommercePaymentAttemptStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

model CommercePaymentAttempt {
  id                 String                        @id @default(uuid())
  commerceOrderId    String
  commerceOrder      CommerceOrder                 @relation(fields: [commerceOrderId], references: [id], onDelete: Cascade)
  provider           String
  providerPaymentId  String?
  /** Merchant-site reference sent to Paynow (unique). */
  merchantReference  String?                       @unique
  /** Paynow's own transaction reference when known. */
  paynowReference    String?
  /** Hash-validated Paynow poll URL only (SSRF-safe host). */
  pollUrl            String?
  payerPhone         String
  amountCents        Int
  currency           String                        @default("usd")
  status             CommercePaymentAttemptStatus  @default(CREATED)
  failureReason      String?
  initiatedAt        DateTime                      @default(now())
  expiresAt          DateTime?
  confirmedAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([commerceOrderId, status])
  @@index([status, expiresAt])
}

model CommerceOrderItem {
  id                   String        @id @default(uuid())
  orderId              String
  order                CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  quantity             Int
  unitPriceCents       Int
  lineTotalCents       Int
  unavailableMarked    Boolean       @default(false)
  createdAt            DateTime      @default(now())
}

model WhatsAppConversation {
  id                   String                    @id @default(uuid())
  phoneNormalized      String
  party                WhatsAppParty
  state                WhatsAppConversationState @default(IDLE)
  merchantId           String?
  /** @deprecated Prefer commerceCustomerId for shoppers. */
  customerUserId       String?
  commerceCustomerId   String?
  commerceCustomer     CommerceCustomer?         @relation(fields: [commerceCustomerId], references: [id], onDelete: SetNull)
  /** Draft cart, pending product choices, last order id, etc. */
  contextJson          Json                      @default("{}")
  updatedAt            DateTime                  @updatedAt
  createdAt            DateTime                  @default(now())

  @@unique([phoneNormalized, party])
  @@index([merchantId])
  @@index([commerceCustomerId])
}

model WhatsAppInboundMessage {
  id                 String   @id @default(uuid())
  providerMessageId  String   @unique
  phoneNormalized    String
  party              WhatsAppParty?
  processedAt        DateTime @default(now())
  summary            String?
}

/** Short-lived guest web basket → WhatsApp restore. Token stored hashed only. */
model GuestCommerceHandoff {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  basketJson    Json
  deliveryLabel String
  deliveryLat   Decimal   @db.Decimal(9, 6)
  deliveryLng   Decimal   @db.Decimal(9, 6)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
  @@index([merchantId])
}
