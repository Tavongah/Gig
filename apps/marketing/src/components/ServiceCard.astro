---
import Icon from "./Icon.astro";
import { formatServicePrice, type ServiceDef, appLinks } from "../data/site";

interface Props {
  service: ServiceDef;
  featured?: boolean;
}
const { service, featured = false } = Astro.props;
---

<article class:list={["service-card reveal", { "service-card--featured": featured }]}>
  <div class="service-card__image">
    <img src={service.image} alt={service.name} width="400" height="240" loading="lazy" decoding="async" />
  </div>
  <div class="service-card__body">
    <div class="service-card__icon" aria-hidden="true">
      <Icon name={service.icon} size={20} />
    </div>
    <h3>{service.name}</h3>
    <p>{service.short}</p>
    <p class="service-card__price">{formatServicePrice(service)}</p>
    <div class="service-card__actions">
      <a class="btn btn--ghost btn--sm" href={`/services/${service.slug}`}>Learn More</a>
      <a class="btn btn--primary btn--sm" href={appLinks.requestHelp}>Request Help</a>
    </div>
  </div>
</article>

<style>
  .service-card {
    background: var(--bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .service-card__image {
    aspect-ratio: 5 / 3;
    overflow: hidden;
  }
  .service-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .service-card:hover .service-card__image img {
    transform: scale(1.04);
  }
  .service-card__body {
    padding: 1.5rem;
  }
  .service-card__icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: var(--purple);
    background: var(--surface);
    margin-bottom: 1rem;
    transition: color 0.3s ease, background 0.3s ease;
  }
  .service-card:hover .service-card__icon {
    color: #fff;
    background: var(--gradient);
  }
  .service-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
  }
  .service-card p {
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
    line-height: 1.55;
  }
  .service-card__price {
    font-weight: 700;
    color: var(--ink) !important;
    font-size: 0.9375rem;
    margin-bottom: 1.25rem !important;
  }
  .service-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
</style>
