---
import CtaButton from "./CtaButton.astro";
import { appLinks } from "../data/site";

interface Props {
  title?: string;
  lead?: string;
  showLogin?: boolean;
}
const {
  title = "Ready to get started?",
  lead = "Request help or join as a worker—both start in the DUTS app.",
  showLogin = true
} = Astro.props;
---

<section class="cta-section">
  <div class="container cta-section__inner reveal">
    <div class="cta-section__copy">
      <h2>{title}</h2>
      <p>{lead}</p>
    </div>
    <div class="btn-group">
      <CtaButton href={appLinks.requestHelp} label="Request Help" />
      <CtaButton href={appLinks.becomeWorker} label="Become a Worker" variant="ghost" />
      {showLogin && <CtaButton href={appLinks.login} label="Login" variant="ghost" />}
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: var(--section-y) 0;
    background: var(--surface);
  }
  .cta-section__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 3rem;
    background: var(--bg);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }
  @media (min-width: 768px) {
    .cta-section__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .cta-section__copy h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .cta-section__copy p {
    margin: 0;
    font-size: 1.0625rem;
    max-width: 36rem;
  }
</style>
