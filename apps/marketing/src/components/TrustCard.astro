---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  body: string;
  icon: string;
}
const { title, body, icon } = Astro.props;
---

<article class="trust-card reveal">
  <div class="trust-card__icon" aria-hidden="true">
    <Icon name={icon} size={22} />
  </div>
  <h3>{title}</h3>
  <p>{body}</p>
</article>

<style>
  .trust-card {
    background: var(--bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .trust-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .trust-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--gradient);
    margin-bottom: 1.25rem;
  }
  .trust-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .trust-card p {
    font-size: 0.9375rem;
    margin: 0;
    line-height: 1.6;
  }
</style>
