---
import { howSteps } from "../data/site";
---

<ol class="timeline">
  {
    howSteps.map((step) => (
      <li class="timeline__step reveal">
        <div class="timeline__marker" aria-hidden="true">
          <span>{step.step}</span>
        </div>
        <div class="timeline__content">
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  @media (min-width: 900px) {
    .timeline {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      position: relative;
    }
    .timeline::before {
      content: "";
      position: absolute;
      top: 28px;
      left: 12%;
      right: 12%;
      height: 2px;
      background: var(--border);
      z-index: 0;
    }
  }
  .timeline__step {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem 0;
  }
  @media (min-width: 900px) {
    .timeline__step {
      text-align: center;
      padding: 0;
    }
  }
  .timeline__marker {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--bg);
    box-shadow: var(--shadow-sm);
    border: 2px solid var(--border);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    color: var(--purple);
    transition: all 0.3s ease;
  }
  @media (min-width: 900px) {
    .timeline__marker {
      margin-inline: auto;
    }
  }
  .timeline__step:hover .timeline__marker {
    color: #fff;
    border-color: transparent;
    background: var(--gradient);
    box-shadow: 0 8px 24px rgba(123, 63, 228, 0.25);
  }
  .timeline__content h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
  }
  .timeline__content p {
    font-size: 0.9375rem;
    margin: 0;
    line-height: 1.6;
  }
</style>
