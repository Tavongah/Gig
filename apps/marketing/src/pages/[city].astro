---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CtaSection from "../components/CtaSection.astro";
import CtaButton from "../components/CtaButton.astro";
import { appLinks, cities, services } from "../data/site";

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug } }));
}

const { city: citySlug } = Astro.params;
const city = cities.find((c) => c.slug === citySlug);
if (!city) return Astro.redirect("/");
---

<BaseLayout
  title={`Local help in ${city.name}, ${city.state}`}
  description={`${city.blurb} Request help or become a worker with DUTS.`}
  canonicalPath={`/${city.slug}`}
>
  <section class="section">
    <div class="container">
      <PageHeader
        label={`${city.name}, ${city.state}`}
        title={`Trusted local help in ${city.name}`}
        lead={city.blurb}
      />
      <div class="btn-group" style="margin-bottom: 3rem">
        <CtaButton href={appLinks.requestHelp} label="Request Help" />
        <CtaButton href={appLinks.becomeWorker} label="Become a Worker" variant="ghost" />
      </div>
      <h2 class="section__title">Available services</h2>
      <div class="grid-3" style="margin-top: 1.5rem">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>
  <CtaSection showLogin={false} />
</BaseLayout>
