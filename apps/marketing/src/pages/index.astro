---
import BaseLayout from "../layouts/BaseLayout.astro";
import { HomePage } from "../components/react/HomePage";
import {
  BRAND,
  SITE_URL,
  SUPPORT_EMAIL,
  solutions,
  howSteps,
  industries,
  principles,
  pathfinderOptions
} from "../data/site";

const title = "DUTS AI | AI Solutions Built for Business Growth";
const description =
  "DUTS AI builds intelligent products, AI agents and business automation that help companies attract customers, improve operations and grow.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: BRAND.name,
    url: SITE_URL,
    email: SUPPORT_EMAIL,
    description,
    logo: new URL("/brand/duts-ai-logo.jpg", SITE_URL).toString(),
    sameAs: []
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: BRAND.name,
    url: SITE_URL,
    description
  }
];
---

<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <noscript>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Practical AI for real businesses</p>
        <h1>AI that helps businesses sell, serve and grow.</h1>
        <p>
          DUTS AI builds intelligent products and custom AI solutions that help businesses attract
          customers, automate operations and work smarter.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact">Talk to DUTS</a>
          <a class="btn btn--ghost" href="/solutions">Explore AI Solutions</a>
        </div>
      </div>
    </section>
  </noscript>
  <HomePage
    client:only="react"
    solutions={[...solutions]}
    steps={[...howSteps]}
    industries={[...industries]}
    principles={[...principles]}
    pathfinderOptions={[...pathfinderOptions]}
  />
</BaseLayout>
