---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import TrustCard from "../components/TrustCard.astro";
import CtaSection from "../components/CtaSection.astro";
import { trustItems } from "../data/site";
---

<BaseLayout
  title="Safety & Trust"
  description="Learn how DUTS approaches trusted workers, secure payments, privacy, support, and transparent pricing."
  canonicalPath="/safety"
>
  <section class="section">
    <div class="container">
      <PageHeader
        label="Safety & Trust"
        title="Designed for confidence"
        lead="Every part of DUTS is built to help you book with peace of mind."
        centered
      />
      <div class="grid-3">
        {trustItems.map((item) => (
          <TrustCard title={item.title} body={item.body} icon={item.icon} />
        ))}
      </div>
    </div>
  </section>
  <CtaSection showLogin={false} />
</BaseLayout>
