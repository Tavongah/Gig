---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SUPPORT_EMAIL } from "../data/site";
---

<BaseLayout
  title="Terms"
  description="Terms information for DUTS AI."
  canonicalPath="/terms"
>
  <section class="page-hero">
    <div class="container">
      <h1>Terms</h1>
      <p>
        Questions about DUTS AI terms of use can be sent to
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
