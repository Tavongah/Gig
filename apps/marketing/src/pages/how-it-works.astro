---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaButton from "../components/CtaButton.astro";
import { appLinks, howSteps } from "../data/site";
---

<BaseLayout
  title="How It Works"
  description="See how DUTS works: choose a service, describe your job, get matched with a local worker, and complete the job."
  canonicalPath="/how-it-works"
>
  <section class="section">
    <div class="container">
      <p class="section__eyebrow">How It Works</p>
      <h1 class="section__title">From request to done—clear and fast</h1>
      <ol class="steps">
        {
          howSteps.map((step) => (
            <li class="card reveal">
              <div class="icon-badge">{step.step}</div>
              <h2>{step.title}</h2>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="ctas">
        <CtaButton href={appLinks.requestHelp} label="Request Help" />
        <CtaButton href={appLinks.becomeWorker} label="Become a Worker" variant="ghost" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(4, 1fr); }
  }
  .steps h2 { font-size: 1.2rem; margin-top: 0.85rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
