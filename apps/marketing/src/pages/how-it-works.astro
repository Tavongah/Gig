---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Timeline from "../components/Timeline.astro";
import CtaSection from "../components/CtaSection.astro";
import CtaButton from "../components/CtaButton.astro";
import { appLinks } from "../data/site";
---

<BaseLayout
  title="How It Works"
  description="See how DUTS works: choose a service, describe your job, get matched with a local worker, and complete the job."
  canonicalPath="/how-it-works"
>
  <section class="section">
    <div class="container">
      <PageHeader
        label="How It Works"
        title="From request to done—clear and fast"
        lead="Four simple steps to get trusted local help when you need it."
      />
      <Timeline />
      <div class="btn-group" style="margin-top: 3rem">
        <CtaButton href={appLinks.requestHelp} label="Request Help" />
        <CtaButton href={appLinks.becomeWorker} label="Become a Worker" variant="ghost" />
      </div>
    </div>
  </section>
  <CtaSection showLogin={false} />
</BaseLayout>
