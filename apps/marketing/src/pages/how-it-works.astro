---
import BaseLayout from "../layouts/BaseLayout.astro";
import { HowItWorksSection } from "../components/react/HowItWorksSection";
import { howSteps } from "../data/site";
import "../styles/home.css";
---

<BaseLayout
  title="How It Works"
  description="From business problem to working AI in four clear stages — discovery, opportunity, build and scale."
  canonicalPath="/how-it-works"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Process</p>
      <h1>Simple path. Serious engineering.</h1>
      <p>We keep the process clear so business owners can move from idea to working AI without the jargon.</p>
    </div>
  </section>
  <HowItWorksSection client:only="react" steps={[...howSteps]} />
  <section class="section section--tight">
    <div class="container" style="text-align:center;">
      <a class="btn btn--primary" href="/contact">Talk to DUTS</a>
    </div>
  </section>
</BaseLayout>
