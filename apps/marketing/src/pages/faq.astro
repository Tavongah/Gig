---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaSection from "../components/CtaSection.astro";
import CtaButton from "../components/CtaButton.astro";
import { appLinks, faqs } from "../data/site";

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a }
  }))
};
---

<BaseLayout
  title="FAQ"
  description="Answers about requesting help, payments, matching speed, cancellations, worker verification, and more."
  canonicalPath="/faq"
  jsonLd={faqLd}
>
  <section class="section">
    <div class="container container--narrow">
      <PageHeader
        label="FAQ"
        title="Frequently asked questions"
        lead="Quick answers to common questions about DUTS."
      />
      <FaqAccordion items={faqs} />
      <div class="btn-group" style="margin-top: 2.5rem">
        <CtaButton href={appLinks.requestHelp} label="Request Help" />
        <CtaButton href="/contact" label="Contact Support" variant="ghost" />
      </div>
    </div>
  </section>
  <CtaSection showLogin={false} />
</BaseLayout>
