---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SUPPORT_EMAIL, SUPPORT_PHONE } from "../data/site";
import "../styles/home.css";
---

<BaseLayout
  title="Talk to DUTS"
  description="Tell us where your team spends time, loses customers or struggles to scale. We'll help identify where AI can help."
  canonicalPath="/contact"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Talk to DUTS</h1>
      <p>
        Share the business challenge you want to solve. We&apos;ll help you identify a practical AI
        starting point.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container" style="display:grid;gap:1rem;max-width:720px;">
      <p id="intent-note" class="notice" hidden style="padding:1rem 1.2rem;border:1px solid var(--border);border-radius:16px;color:var(--ink-soft);"></p>
      <article class="duts-industry" style="padding:1.5rem;">
        <h2 style="font-size:1.2rem;margin-bottom:0.5rem;">Email</h2>
        <p>
          <a href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent("Talk to DUTS AI")}`}>{SUPPORT_EMAIL}</a>
        </p>
      </article>
      {
        SUPPORT_PHONE ? (
          <article class="duts-industry" style="padding:1.5rem;">
            <h2 style="font-size:1.2rem;margin-bottom:0.5rem;">Phone</h2>
            <p>
              <a href={`tel:${SUPPORT_PHONE}`}>{SUPPORT_PHONE}</a>
            </p>
          </article>
        ) : null
      }
      <div class="btn-row">
        <a class="btn btn--primary" href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent("Talk to DUTS AI")}`}>
          Email DUTS
        </a>
        <a class="btn btn--ghost" href="/solutions">Explore Solutions</a>
      </div>
    </div>
  </section>
  <script>
    const note = document.getElementById("intent-note");
    const intent = new URLSearchParams(window.location.search).get("intent");
    if (note && intent) {
      note.hidden = false;
      note.innerHTML = `You selected: <strong style="color:var(--ink)">${intent.replace(/-/g, " ")}</strong>`;
    }
  </script>
</BaseLayout>
