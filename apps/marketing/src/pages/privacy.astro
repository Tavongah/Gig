---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SUPPORT_EMAIL } from "../data/site";
---

<BaseLayout
  title="Privacy"
  description="Privacy information for DUTS AI."
  canonicalPath="/privacy"
>
  <section class="page-hero">
    <div class="container">
      <h1>Privacy</h1>
      <p>
        DUTS AI respects your privacy. For questions about how we handle information, contact
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
