---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import CtaSection from "../../components/CtaSection.astro";
import CtaButton from "../../components/CtaButton.astro";
import { appLinks, services } from "../../data/site";
---

<BaseLayout
  title="Services"
  description="Browse DUTS services including moving assistance, cleaning, lawn care, car detailing, furniture assembly, junk removal, and event help."
  canonicalPath="/services"
>
  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Services</span>
      </nav>
      <PageHeader
        label="Services"
        title="Local help for everyday jobs"
        lead="Every service links to detailed information and a direct path into the DUTS app."
      />
      <div class="grid-3">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
      <div class="btn-group" style="margin-top: 3rem">
        <CtaButton href={appLinks.requestHelp} label="Request Help" />
        <CtaButton href={appLinks.becomeWorker} label="Become a Worker" variant="ghost" />
      </div>
    </div>
  </section>
  <CtaSection showLogin={false} />
</BaseLayout>
