---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaButton from "../../components/CtaButton.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import CtaSection from "../../components/CtaSection.astro";
import { appLinks, formatFromCents, formatServicePrice, getService, services } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const { slug } = Astro.params;
const service = getService(slug!);
if (!service) {
  return Astro.redirect("/services");
}

const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  description: service.description,
  image: service.image,
  provider: { "@type": "Organization", name: "DUTS" },
  areaServed: "Connecticut",
  offers: {
    "@type": "Offer",
    priceCurrency: "USD",
    price: (service.startingFromCents / 100).toFixed(2),
    description: "Starting estimate"
  }
};
---

<BaseLayout
  title={`${service.name} near you`}
  description={service.description}
  canonicalPath={`/services/${service.slug}`}
  jsonLd={jsonLd}
>
  <section class="service-hero">
    <div class="container service-hero__grid">
      <div class="service-hero__copy reveal">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> / <a href="/services">Services</a> / <span>{service.name}</span>
        </nav>
        <p class="section__label">Service</p>
        <h1>{service.name}</h1>
        <p class="service-hero__lead">{service.description}</p>
        <p class="service-hero__price">{service.pricingModel === "HOURLY" ? formatServicePrice(service) : `Starting from ${formatFromCents(service.startingFromCents)}`}</p>
        <div class="btn-group">
          <CtaButton href={appLinks.requestHelp} label="Request this Service" />
          <CtaButton href={appLinks.login} label="Login" variant="ghost" />
        </div>
      </div>
      <div class="service-hero__image reveal">
        <img src={service.image} alt={service.name} width="640" height="480" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <h2>What's included</h2>
      <ul class="includes">
        {service.includes.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Pricing</h2>
      <p>
        {service.pricingModel === "HOURLY" ? (
          <>
            <strong>{formatServicePrice(service)}</strong>. Final pricing depends on location, job size, duration, and
            complexity. You'll see clear details as you request help in the app.
          </>
        ) : (
          <>
            Starting from <strong>{formatFromCents(service.startingFromCents)}</strong>. Final pricing depends on
            location, job size, duration, and complexity. You'll see clear details as you request help in the app.
          </>
        )}
      </p>

      <h2>Questions</h2>
      <FaqAccordion items={service.faqs} />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <h2 class="section__title">Related services</h2>
      <div class="related">
        {
          related.map((item) => (
            <a class="related__card reveal" href={`/services/${item.slug}`}>
              <img src={item.image} alt={item.name} width="320" height="192" loading="lazy" />
              <div>
                <strong>{item.name}</strong>
                <span>{formatServicePrice(item)}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection showLogin={false} />
</BaseLayout>

<style>
  .service-hero {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    background: var(--bg);
  }
  .service-hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .service-hero__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .service-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .service-hero__lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .service-hero__price {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--ink) !important;
    margin-bottom: 1.5rem !important;
  }
  .service-hero__image {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .service-hero__image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .includes {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 2rem;
    padding-left: 1.25rem;
  }
  h2 {
    font-size: 1.375rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .related {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 768px) {
    .related {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .related__card {
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .related__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .related__card img {
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
  }
  .related__card div {
    padding: 1rem 1.25rem;
    display: grid;
    gap: 0.25rem;
  }
  .related__card strong {
    font-family: var(--font-display);
    color: var(--ink);
  }
  .related__card span {
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
