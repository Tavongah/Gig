NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
MOBILE_PUBLIC_API_URL=http://localhost:4000/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gigflow
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-min-24-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
TRUST_PROXY=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mobile (Expo) — set in apps/mobile/.env or shell before `expo start`
EXPO_PUBLIC_API_URL=http://localhost:4000/v1

# Admin dashboard — set in apps/admin/.env
VITE_API_URL=http://localhost:4000/v1

# Docker full stack only
RUN_SEED=true
