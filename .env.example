NODE_ENV=development
# Gig lane: development | test | pilot | staging | production
APP_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
MOBILE_PUBLIC_API_URL=http://localhost:4000/v1
# MUST be a Gig-owned DB (e.g. duts_gig_dev). NEVER duts_whitelabel (IA SaaS).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/duts_gig_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-min-24-chars
# Admin dashboard login (used by prisma seed) — use a strong unique password
ADMIN_SEED_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
TRUST_PROXY=false

# DUTS Delivery product switch (default enabled). Set false to pause delivery in an environment.
# DELIVERY_ENABLED=true
# Auto-approve delay after delivery PIN (seconds). Pilot default 60.
# DELIVERY_AUTO_APPROVE_SECONDS=60
# PIN lock (defaults: 5 attempts / 15 minutes)
# DELIVERY_PIN_MAX_ATTEMPTS=5
# DELIVERY_PIN_LOCK_MINUTES=15
# Structured delivery/gig flow logs in production: DUTS_FLOW_LOGS=1 (pilot logs always when APP_ENV=pilot)

# Stage 4/4.5 WhatsApp — official Cloud API. Default provider=mock for local/tests.
# WHATSAPP_PROVIDER=mock
# WHATSAPP_PROVIDER=meta
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=duts-whatsapp-verify
# Webhook path (Meta): GET/POST {API_PUBLIC_URL}/v1/whatsapp/webhook
# Twilio WhatsApp testing transport (do not register production +263 here):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_WEBHOOK_URL={API_PUBLIC_URL}/v1/whatsapp/twilio
# Webhook path (Twilio): POST {API_PUBLIC_URL}/v1/whatsapp/twilio
# Optional approved template names (Meta Business Manager):
# WHATSAPP_TEMPLATE_MERCHANT_NEW_ORDER=
# WHATSAPP_TEMPLATE_ORDER_ACCEPTED=
# WHATSAPP_TEMPLATE_COURIER_ASSIGNED=
# WHATSAPP_TEMPLATE_ON_THE_WAY=
# WHATSAPP_TEMPLATE_DELIVERED=
# WHATSAPP_TEMPLATE_CANCELLED=
# Commerce payment for WhatsApp orders: CASH | TEST_BYPASS | STRIPE | ECOCASH | ONEMONEY
# Pilot default CASH (due on delivery). TEST_BYPASS forbidden in pilot/production.
COMMERCE_PAYMENT_METHOD=CASH
# Commerce payment rail: mock | paynow | ecocash
COMMERCE_PAYMENT_PROVIDER=mock
# COMMERCE_PAYMENT_TTL_SECONDS=900
# ALLOW_COMMERCE_PAYMENT_MOCK=true
# Paynow (when COMMERCE_PAYMENT_PROVIDER=paynow):
#   local = in-process simulator | test = real Paynow Test Mode API | live = FAIL-CLOSED
# PAYNOW_MODE=local
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# PAYNOW_AUTH_EMAIL=
# Required for PAYNOW_MODE=test (builds resulturl):
# API_PUBLIC_URL=https://api.duts.tech
# NEVER commit PAYNOW_INTEGRATION_KEY. NEVER set PAYNOW_MODE=live.
# Non-production pilot merchant seed (npm run seed:pilot-merchant -w @gigflow/api):
# SEED_PILOT_MERCHANT_WHATSAPP=+2637…
# SEED_PILOT_MERCHANT_LAT=-17.86
# SEED_PILOT_MERCHANT_LNG=30.99
# SEED_PILOT_MERCHANT_AREA=Glen Norah
# Meriden CT mock shop for E2E (npm run seed:meriden-test-merchant -w @gigflow/api):
# SEED_MERIDEN_TEST_MERCHANT_WHATSAPP=+1…   # your test merchant WhatsApp; never commit
# Blocked in APP_ENV=production|pilot — use admin onboarding UI there.
# Merchant must accept within N seconds (default 900 = 15 min)
# COMMERCE_MERCHANT_TIMEOUT_SECONDS=900
# COMMERCE_CART_TTL_SECONDS=2700
# WHATSAPP_DISABLE_AI=true
# SEED_MARKETPLACE_TEST_DATA=true

# Firebase — required for Google/Apple sign-in (see FIREBASE_SETUP.md)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe — required for APP_ENV=pilot|staging and NODE_ENV=production (use sk_test_/pk_test_ for pilot)
# Webhook: stripe listen --forward-to localhost:4000/v1/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Never enable in pilot/staging. Production emergency only:
# ALLOW_DEV_PAYMENT_BYPASS=true
# ALLOW_DEV_SESSION=true
# Beta only — log email/phone verification to API stdout when SendGrid/Twilio not wired yet:
# LOG_VERIFICATION_TO_CONSOLE=true
MOBILE_PUBLIC_URL=http://localhost:8081
GOOGLE_MAPS_API_KEY=
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mobile (Expo) — set in apps/mobile/.env or shell before `expo start`
# Physical device: use your LAN IP, e.g. http://192.168.1.20:4000/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Admin dashboard — set in apps/admin/.env
VITE_API_URL=http://localhost:4000/v1

# Docker full stack only
RUN_SEED=true

# Production (DigitalOcean) — see deploy/digitalocean/.env.production.example
