NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
MOBILE_PUBLIC_API_URL=http://localhost:4000/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gigflow
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-min-24-chars
# Admin dashboard login (used by prisma seed) — use a strong unique password
ADMIN_SEED_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
TRUST_PROXY=false
# Firebase — required for Google/Apple sign-in (see FIREBASE_SETUP.md)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe — required in production (test keys OK for staging)
# Webhook: stripe listen --forward-to localhost:4000/v1/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Never enable in production unless debugging payments locally on hosted API:
# ALLOW_DEV_PAYMENT_BYPASS=true
# ALLOW_DEV_SESSION=true
# Beta only — log email/phone verification to API stdout when SendGrid/Twilio not wired yet:
# LOG_VERIFICATION_TO_CONSOLE=true
MOBILE_PUBLIC_URL=http://localhost:8081
GOOGLE_MAPS_API_KEY=
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mobile (Expo) — set in apps/mobile/.env or shell before `expo start`
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Admin dashboard — set in apps/admin/.env
VITE_API_URL=http://localhost:4000/v1

# Docker full stack only
RUN_SEED=true

# Production (DigitalOcean) — see deploy/digitalocean/.env.production.example
