{
  "name": "gigflow",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time local gig marketplace MVP",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run build --workspace @gigflow/shared && npm run dev --workspace @gigflow/api",
    "dev:admin": "npm run dev --workspace @gigflow/admin",
    "dev:marketing": "npm run dev --workspace @gigflow/marketing",
    "dev:mobile": "npm run build --workspace @gigflow/shared && npm run dev --workspace @gigflow/mobile",
    "build": "npm run build --workspace @gigflow/shared && npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @gigflow/shared && npm run prisma:generate --workspace @gigflow/api && npm run build --workspace @gigflow/api",
    "start:api": "npm run start --workspace @gigflow/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "npm run prisma:migrate --workspace @gigflow/api",
    "db:seed": "npm run prisma:seed --workspace @gigflow/api",
    "stripe:listen": "stripe listen --forward-to localhost:4000/v1/payments/webhook",
    "setup:firebase": "node scripts/import-firebase-env.mjs",
    "firebase:config": "node scripts/generate-firebase-native-config.mjs",
    "docker:up": "docker compose up --build",
    "eas-build-pre-install": "node apps/mobile/scripts/eas-pre-install.js",
    "eas-build-post-install": "npm run build --workspace @gigflow/shared"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
